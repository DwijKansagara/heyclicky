{
  "appId": "com.dwijkansagara.heyclicky",
  "productName": "HeyClicky",
  "electronVersion": "34.5.8",
  "copyright": "Copyright © 2026 Dwij Kansagara (MIT Licensed)",
  "directories": {
    "output": "dist",
    "buildResources": "build"
  },
  "files": [
    "dist-electron/**/*",
    "dist-renderer/**/*",
    "package.json"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "requestedExecutionLevel": "asInvoker"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "HeyClicky"
  }
}
